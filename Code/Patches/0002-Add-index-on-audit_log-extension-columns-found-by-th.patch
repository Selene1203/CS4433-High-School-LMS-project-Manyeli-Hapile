diff --git a/docs/phase3/db/schema.sql b/docs/phase3/db/schema.sql
index 5fd6242..d7df884 100644
--- a/docs/phase3/db/schema.sql
+++ b/docs/phase3/db/schema.sql
@@ -104,6 +104,8 @@ CREATE INDEX idx_submission_student ON submission(student_id);
 CREATE INDEX idx_mark_status        ON mark(status);
 CREATE INDEX idx_enrolment_course   ON enrolment(course_id);
 CREATE INDEX idx_assignment_course  ON assignment(course_id);
+-- found by the Week 6 performance test: without this, replacing an extension scans the whole audit log
+CREATE INDEX idx_audit_extension    ON audit_log(ext_assignment_id, ext_student_id);
 
 -- the audit log is append only (NFR-06)
 CREATE TRIGGER audit_no_update BEFORE UPDATE ON audit_log
diff --git a/src/database.cpp b/src/database.cpp
index cc723d0..17206c5 100644
--- a/src/database.cpp
+++ b/src/database.cpp
@@ -22,6 +22,10 @@ Database::Database(const std::string& path) {
                   "SELECT count(*) FROM sqlite_master WHERE name='app_user'");
   check.step();
   if (check.getInt(0) == 0) exec(schemaSql());
+  // v1.0 and v1.1 databases do not have this index, so add it when they are
+  // opened. It is a no-op on a database that already has it.
+  exec("CREATE INDEX IF NOT EXISTS idx_audit_extension ON "
+       "audit_log(ext_assignment_id, ext_student_id);");
 }
 
